# ============================================================
# ShopCare 后端环境变量模板
#
# 用法: 把本文件复制成 backend/.env, 再按实际情况改。
#       然后启动时让进程读到它(见 backend/main.py 顶部的 _load_dotenv)。
#
# 重要: .env 里全是密码和密钥, **绝对不要提交到 git**。
#       .gitignore 里已经加上了 backend/.env。
# ============================================================

# ---------------- MySQL (必配, 否则降级到内存) ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopcare
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=3
# 启动时自动执行 backend/schema.sql 建库建表(需要账号有建库权限; 没有就设 false)
DB_AUTO_CREATE=true

# ---------------- Redis (可选, 不配则限流/缓存退化为进程内) ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------- 认证 ----------------
# 生产环境务必替换: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
# 首次启动会自动创建这个管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ALLOW_REGISTER=true

# ---------------- 模型 ----------------
# 页面"模型选择"下拉框里会出现哪些选项(逗号分隔): rf,fasttext,bert
MODEL_AVAILABLE=rf,fasttext,bert
DEFAULT_MODEL=bert
# 拒识后是否升级到 LLM 兜底。默认 false: 避免不知情地产生 API 费用。
# 打开前请先设置 DEEPSEEK_API_KEY (或兼容的 OpenAI 风格接口)。
ENABLE_LLM_FALLBACK=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------------- 拒识阈值 ----------------
LABEL_THRESHOLD=0.5
GLOBAL_THRESHOLD=0.8

# ---------------- 服务 ----------------
# 单 IP 每分钟请求上限
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
LOG_DIR=backend/logs
CORS_ORIGINS=*
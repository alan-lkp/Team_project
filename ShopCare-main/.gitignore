# ============================================================
# ShopCare .gitignore
#
# 注意: 本项目的 git 仓库根在**上一级目录**(D:\project_File),
#       本文件是子目录级 .gitignore, 里面的路径都相对于 ShopCare-main/.
# ============================================================

# ---------------- 密钥与本地配置: 绝对不能提交 ----------------
# backend/.env 里是数据库密码与 JWT 密钥, 一旦提交就等于泄露.
# backend/.env.example 是脱敏模板, 要保留.
backend/.env
.env
.env.local

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------- 虚拟环境 ----------------
.venv/
venv/
env/

# ---------------- 运行时产物 ----------------
# 日志是运行期生成的, 不随仓库分发
backend/logs/
*.log

# ---------------- 编辑器 / 系统 ----------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------------- 大体积预训练模型 ----------------
# 400 MB 级的预训练权重, 按 docs/环境安装指南.md 自行放置, 不入库.
# (02-rf / 03-fasttext 训练出来的模型产物体积可控, 属于项目交付的一部分, 不在此忽略)
04-bert/bert-base-chinese/

# ---------------- 语料重建时的自动备份 ----------------
# tools/build_dataset_v2.py 每次重建前会把旧的 train/dev/test.txt 备份到
# 01-data/backup/<时间戳>/. 这是防误操作的本地保险, 不需要入库 ——
# 被覆盖掉的那一版本来就在 git 历史里(见 git log 01-data/)。
01-data/backup/